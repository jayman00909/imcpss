DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=https://your-vercel-frontend-domain.vercel.app
NODE_ENV=production
PORT=5000

# Required to register a manager account. Leave unset to allow open manager
# signup (convenient locally, not advisable in production).
MANAGER_SIGNUP_CODE=choose-a-code-and-share-it-only-with-managers

# Password reset email delivery. Configure ONE option. With none set, the
# reset link is only written to the server log and no mail is sent.
#
# MAIL_FROM must be an address the provider has verified as a sender.
MAIL_FROM=MCO <your.address@gmail.com>

# Option A (recommended) — Brevo. Sends over HTTPS, so it works on hosts that
# block outbound SMTP, and a single verified sender address is enough: no
# domain required. Free tier covers 300 emails/day.
BREVO_API_KEY=

# Option B — Resend. Also HTTPS. The shared onboarding@resend.dev sender only
# delivers to your own Resend account address, so reaching other users needs a
# domain you have verified.
RESEND_API_KEY=

# Option C — direct SMTP, e.g. Gmail with an App Password. Works locally but
# NOT on hosts that block outbound SMTP (Render's free tier does; the
# connection simply times out). Prefer an HTTP provider in production.
SMTP_USER=
SMTP_PASS=
