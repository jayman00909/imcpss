DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=https://your-vercel-frontend-domain.vercel.app
NODE_ENV=production
PORT=5000

# Required to register a manager account. Leave unset to allow open manager
# signup (convenient locally, not advisable in production).
MANAGER_SIGNUP_CODE=choose-a-code-and-share-it-only-with-managers

# Password reset email delivery. Configure ONE of the two options below.
# With neither set, the reset link is only written to the server log.
#
# Option A (recommended) — send through your own Gmail. Reaches any user and
# needs no domain. SMTP_PASS must be a Google App Password, created at
# https://myaccount.google.com/apppasswords with 2-Step Verification enabled.
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM=MCO <your.address@gmail.com>

# Option B — Resend. Note that the shared onboarding@resend.dev sender only
# delivers to your own Resend account address; reaching other users requires
# verifying a domain you own.
RESEND_API_KEY=
