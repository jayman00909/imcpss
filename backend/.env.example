DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=https://your-vercel-frontend-domain.vercel.app
NODE_ENV=production
PORT=5000

# Required to register a manager account. Leave unset to allow open manager
# signup (convenient locally, not advisable in production).
MANAGER_SIGNUP_CODE=choose-a-code-and-share-it-only-with-managers

# Password reset email delivery. Without RESEND_API_KEY the reset link is
# written to the server log instead of being emailed, so reset does not
# actually reach users until this is set.
RESEND_API_KEY=
MAIL_FROM=MCO <onboarding@resend.dev>
